RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DATABASE_URL=
AUTH_SECRET=
NERVE_API_URL=
NERVE_API_KEY=

# Meta App ID and WhatsApp Embedded Signup Facebook Login for Business
# configuration id. Both are safe to expose to the browser (they are
# public client identifiers, not secrets -- comparable to an OAuth
# client_id) and are required by the Meta JS SDK to launch the "Connect
# WhatsApp" flow from /dashboard. The App ID must match the same Meta App
# whose App Secret is configured on the Nerve server (see Nerve's
# .env.example META_APP_ID/META_APP_SECRET) -- Nylvex never holds the App
# Secret or any Meta access token itself.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=
